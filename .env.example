# =====================================================================
# RODOMAX HUB — variáveis da APLICAÇÃO WEB (backend Node.js)
# Copie para ".env" (na raiz do projeto) e ajuste. NUNCA versione o .env.
# Credenciais do PostgreSQL, Gmail e SMTP ficam no n8n (Credentials), não aqui.
# =====================================================================

# Porta da aplicação web (http://localhost:3000)
APP_PORT=3000

# Endereço do n8n visto pelo backend.
#  - backend rodando no Windows (npm start):           http://localhost:5678
#  - backend em container na rede rodomax-network:      http://n8n:5678
N8N_BASE_URL=http://localhost:5678

# /webhook = workflow ATIVO/publicado (uso normal)
# /webhook-test = modo teste do editor ("Listen for test event"), só para depuração
N8N_WEBHOOK_PATH=/webhook

# Tempo máximo de espera por uma resposta do n8n (ms). CSV grande pode levar alguns segundos.
N8N_TIMEOUT_MS=120000

# Telegram (opcional): token do bot criado no @BotFather. Vazio = conector desligado.
TELEGRAM_BOT_TOKEN=
# Não altere (usado apenas em testes automatizados com API simulada)
TELEGRAM_API_BASE=https://api.telegram.org
